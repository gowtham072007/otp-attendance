# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/otp_attendance

# Security
SECRET_KEY=generate_a_secure_random_string_here_and_keep_it_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Initial Admin setup (Email of the person who should be the admin)
INITIAL_ADMIN_EMAIL=admin@example.com
ADMIN_REGISTRATION_KEY=admin123

# Geofence Configuration (Optional)
TARGET_LATITUDE=8.732309
TARGET_LONGITUDE=77.723764
GEOFENCE_RADIUS_METERS=500.0

# SMTP Email Configuration (Optional - for sending OTP via email to students)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=Attendance System <noreply@fxec.edu.in>
SMTP_USE_TLS=true
